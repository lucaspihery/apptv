<?xml version="1.0" encoding="utf-8"?>
<!-- Beaucoup de serveurs Xtream sont en HTTP : le trafic en clair est autorisé. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
